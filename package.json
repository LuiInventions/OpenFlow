{
  "name": "openflow",
  "version": "1.5.39",
  "author": "LuiInventions",
  "license": "GPL-3.0-only",
  "description": "Local-first voice dictation, notes, and screenshot dock for Windows. Includes local open-source Parakeet v3 STT and optional OpenAI API support.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/flow.test.js test/providers.test.js test/store.test.js test/commands.test.js test/cues.test.js test/audio.test.js test/note-improve.test.js test/dictation-cleanup.test.js test/api-key-status.test.js test/usage.test.js test/text-models.test.js test/compatibility.test.js test/model-download.test.js test/parakeet.test.js test/shortcut.test.js test/chord-hook.test.js test/voice-meter.test.js",
    "assets": "node scripts/write-assets.js",
    "dist": "electron-builder --win nsis-web --publish never",
    "dist:local": "electron-builder --config build/local.cjs --win nsis --publish never",
    "verify:package": "node scripts/verify-package.cjs",
    "verify:script-copy": "electron scripts/verify-script-copy.cjs",
    "verify:note-format": "electron scripts/verify-note-format.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "local.openflow.desk",
    "productName": "OpenFlow",
    "publish": [
      {
        "provider": "github",
        "owner": "LuiInventions",
        "repo": "OpenFlow"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "src/**/*",
      "node_modules/sherpa-onnx-*/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sherpa-onnx-*/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/flameshot/flameshot-14.0.0-win64",
        "to": "flameshot",
        "filter": [
          "bin/**/*",
          "LICENSE",
          "!bin/vc_redist.x64.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis-web"
      ],
      "icon": "build/icon.png",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsisWeb": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "shortcutName": "OpenFlow",
      "artifactName": "OpenFlow-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "sherpa-onnx-node": "^1.13.8"
  }
}
